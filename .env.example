# Copia este archivo como .env (git lo ignora) y completa los valores desde los paneles.
# Nunca pongas valores reales en este archivo.

# Supabase #1 · Postgres (Connect → Session pooler, puerto 5432)
DB_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.jcuzocrgyomnuagvnwra
DB_PASSWORD=

# Supabase #1 · Auth (JWKS público) y Storage
SUPABASE_URL=https://jcuzocrgyomnuagvnwra.supabase.co
# Project Settings → API Keys → Secret keys (sb_secret_...). Solo backend; nunca en la web.
SUPABASE_SECRET_KEY=
# Project Settings → API Keys → Publishable key (sb_publishable_...). Es pública; prellena el token de prueba de Swagger.
SUPABASE_PUBLISHABLE_KEY=

# Orígenes de la web separados por coma (el primero arma los enlaces de invitación)
FRONTEND_URLS=http://localhost:5173

# Correo que recibe ADMINISTRADOR al registrarse mientras no haya ningún admin
BOOTSTRAP_ADMIN_EMAIL=

# Shared secret de los disparadores de analytics (vacío = webhooks deshabilitados)
ANALYTICS_WEBHOOK_SECRET=

SERVER_PORT=8082
